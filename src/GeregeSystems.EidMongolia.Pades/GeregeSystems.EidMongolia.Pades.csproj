<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>GeregeSystems.EidMongolia.Pades</RootNamespace>

    <PackageId>GeregeSystems.EidMongolia.Pades</PackageId>
    <Authors>Gerege Systems LLC</Authors>
    <Company>Gerege Systems LLC</Company>
    <Description>eID Mongolia client-side PAdES for .NET (PDF never leaves the client): Prepare → citizen signs the 32-byte DTBS on phone/token → CompleteAsync (RFC 3161 TSA, OCSP/CRL, DSS). Native C# port of the Go reference, byte-identical output. The «My QR» types (GeregeSystems.EidMongolia.Qr) moved to the core package GeregeSystems.EidMongolia in 0.17.0 and are type-forwarded from here, so code built against earlier versions keeps working.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>eid;mongolia;pades;pdf;signature;etsi;qr;identity</PackageTags>
    <RepositoryUrl>https://github.com/gerege-systems/eid-mongolia-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://developer.eidmongolia.mn/</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- core / Pades / AspNetCore нэг хувилбартай (lockstep); pack нь core-ийн ProjectReference-ийг ижил хувилбарын
         PackageReference болгоно. -->
    <Version>0.18.0</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- «Миний QR»-ийн төрлүүд core-д; Properties/TypeForwards.cs нь 0.16.0-ийн хэрэглэгчдэд дамжуулна. -->
    <ProjectReference Include="../GeregeSystems.EidMongolia/GeregeSystems.EidMongolia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeregeSystems.EidMongolia.Pades.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="Trust/*.pem" LogicalName="eid.%(Filename).pem" />
    <EmbeddedResource Include="Assets/*.zlib;Assets/*.json" LogicalName="eid.assets.%(Filename)%(Extension)" />
    <None Include="Assets/OFL.txt" Pack="true" PackagePath="/licenses/NotoSans-OFL.txt" />
    <None Include="Pdf/LICENSE.digitorus-pdf" Pack="true" PackagePath="/licenses/" />
    <None Include="Pdf/LICENSE.digitorus-pdfsign" Pack="true" PackagePath="/licenses/" />
  </ItemGroup>

</Project>
