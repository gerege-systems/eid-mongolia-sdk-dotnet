<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>GeregeSystems.EidMongolia.Pades</RootNamespace>

    <PackageId>GeregeSystems.EidMongolia.Pades</PackageId>
    <Authors>Gerege Systems LLC</Authors>
    <Company>Gerege Systems LLC</Company>
    <Description>eID Mongolia client-side PAdES for .NET (PDF never leaves the client): Prepare → citizen signs the 32-byte DTBS on phone/token → CompleteAsync (RFC 3161 TSA, OCSP/CRL, DSS). Native C# port of the Go reference, byte-identical output. Also: «My QR» RP client (GeregeSystems.EidMongolia.Qr) — verified CA attribute presentations (ES256 JWS/JWKS).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>eid;mongolia;pades;pdf;signature;etsi;qr;identity</PackageTags>
    <RepositoryUrl>https://github.com/gerege-systems/eid-mongolia-sdk-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://developer.eidmongolia.mn/</PackageProjectUrl>
    <Version>0.11.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeregeSystems.EidMongolia.Pades.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="Trust/*.pem" LogicalName="eid.%(Filename).pem" />
    <EmbeddedResource Include="Assets/*.zlib;Assets/*.json" LogicalName="eid.assets.%(Filename)%(Extension)" />
    <None Include="Assets/OFL.txt" Pack="true" PackagePath="/licenses/NotoSans-OFL.txt" />
    <None Include="Pdf/LICENSE.digitorus-pdf" Pack="true" PackagePath="/licenses/" />
    <None Include="Pdf/LICENSE.digitorus-pdfsign" Pack="true" PackagePath="/licenses/" />
  </ItemGroup>

</Project>
